generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
  completed
}

enum ContactStatus {
  new
  read
  replied
  archived
}

enum ServiceType {
  primo_colloquio
  sostegno_psicologico
  potenziamento_cognitivo
  screening_dsa
  ansia
  eta_evolutiva
  genitorialita
  relazioni
  autostima
  traumi
}

model Client {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String            @map("full_name")
  email        String            @unique
  phone        String?
  notes        String?
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(6)
  appointments Appointment[]
  informedConsents InformedConsent[]
  messages     ContactMessage[]

  @@index([email])
  @@index([deletedAt])
  @@map("clients")
}

model Service {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String        @unique
  title         String
  subtitle      String?
  description   String
  iconLabel     String?       @map("icon_label")
  priceLabel    String?       @map("price_label")
  contentType   String        @default("servizio") @map("content_type")
  displayOrder  Int           @default(0) @map("display_order")
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(6)
  appointments  Appointment[]
  messages      ContactMessage[]
  blogPosts     BlogPost[]
  benefits      ServiceBenefit[]

  @@index([active, contentType, displayOrder])
  @@index([deletedAt])
  @@map("services")
}

model ServiceBenefit {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId    String   @map("service_id") @db.Uuid
  benefit      String
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, displayOrder])
  @@map("service_benefits")
}

model Appointment {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String            @map("client_id") @db.Uuid
  serviceId       String?           @map("service_id") @db.Uuid
  serviceType     ServiceType       @default(primo_colloquio) @map("service_type")
  scheduledDate   DateTime          @map("scheduled_date") @db.Date
  timeSlot        String            @map("time_slot")
  location        String?
  status          AppointmentStatus @default(pending)
  notes           String?
  privacyAccepted Boolean           @default(false) @map("privacy_accepted")
  informedConsentAccepted Boolean   @default(false) @map("informed_consent_accepted")
  confirmationEmailSent Boolean     @default(false) @map("confirmation_email_sent")
  confirmationEmailSentAt DateTime? @map("confirmation_email_sent_at") @db.Timestamptz(6)
  confirmationEmailCount Int        @default(0) @map("confirmation_email_count")
  reviewRequestSent Boolean         @default(false) @map("review_request_sent")
  reviewRequestSentAt DateTime?     @map("review_request_sent_at") @db.Timestamptz(6)
  reviewRequestCount Int            @default(0) @map("review_request_count")
  reviewToken     String            @unique @default(dbgenerated("gen_random_uuid()")) @map("review_token") @db.Uuid
  source          String            @default("website")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)
  client          Client            @relation(fields: [clientId], references: [id])
  service         Service?          @relation(fields: [serviceId], references: [id])
  informedConsent InformedConsent?

  @@index([scheduledDate, timeSlot])
  @@index([status, scheduledDate])
  @@index([serviceType])
  @@index([reviewToken])
  @@index([clientId])
  @@index([deletedAt])
  @@map("appointments")
}

model InformedConsent {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId    String      @unique @map("appointment_id") @db.Uuid
  clientId         String      @map("client_id") @db.Uuid
  subjectType      String      @default("adult") @map("subject_type")
  gender           String?
  clientFullName   String      @map("client_full_name")
  clientEmail      String      @map("client_email")
  phone            String?
  fiscalCode       String?     @map("fiscal_code")
  birthPlace       String?     @map("birth_place")
  birthDate        DateTime?   @map("birth_date") @db.Date
  residenceCity    String?     @map("residence_city")
  residenceAddress String?     @map("residence_address")
  residenceNumber  String?     @map("residence_number")
  serviceKind      String      @default("consulenza") @map("service_kind")
  serviceOther     String?     @map("service_other")
  minorFullName    String?     @map("minor_full_name")
  tutorFullName    String?     @map("tutor_full_name")
  tutorBirthPlace  String?     @map("tutor_birth_place")
  tutorBirthDate   DateTime?   @map("tutor_birth_date") @db.Date
  tutorResidenceCity String?   @map("tutor_residence_city")
  tutorResidenceAddress String? @map("tutor_residence_address")
  tutorResidenceNumber String?  @map("tutor_residence_number")
  secondTutorFullName String?  @map("second_tutor_full_name")
  secondTutorBirthPlace String? @map("second_tutor_birth_place")
  secondTutorBirthDate DateTime? @map("second_tutor_birth_date") @db.Date
  secondTutorResidenceCity String? @map("second_tutor_residence_city")
  secondTutorResidenceAddress String? @map("second_tutor_residence_address")
  secondTutorResidenceNumber String? @map("second_tutor_residence_number")
  compensationAmount String    @default("45") @map("compensation_amount")
  taxRegime        String?     @map("tax_regime")
  paymentMethod    String?     @map("payment_method")
  signatureBox     String      @default("adult") @map("signature_box")
  personalDataConsentChoice String @default("granted") @map("personal_data_consent_choice")
  privacyConsent   Boolean     @default(true) @map("privacy_consent")
  termsAccepted    Boolean     @default(true) @map("terms_accepted")
  signedName       String      @map("signed_name")
  pdfUrl           String      @map("pdf_url")
  pdfPublicId      String      @map("pdf_public_id")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(6)
  appointment      Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client           Client      @relation(fields: [clientId], references: [id])

  @@index([clientFullName])
  @@index([clientEmail])
  @@index([fiscalCode])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("informed_consents")
}

model CookieConsentLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  choice       String   // "accept_all" | "reject_all" | "custom"
  analytics    Boolean  @default(false)
  policyVersion Int     @default(1) @map("policy_version")
  userAgent    String?  @map("user_agent")
  ipHash       String?  @map("ip_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("cookie_consent_logs")
}

model BookingClosure {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date      DateTime @unique @db.Date
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("booking_closures")
}

model BookingSchedule {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  location     String   @default("sede1")
  dayOfWeek    Int      @map("day_of_week")
  isOpen       Boolean  @default(true) @map("is_open")
  opensAt      String   @default("09:00") @map("opens_at")
  closesAt     String   @default("19:00") @map("closes_at")
  slotMinutes  Int      @default(60) @map("slot_minutes")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([location, dayOfWeek])
  @@index([location, dayOfWeek])
  @@map("booking_schedules")
}

model ContactMessage {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String?       @map("client_id") @db.Uuid
  serviceId       String?       @map("service_id") @db.Uuid
  name            String
  email           String
  phone           String?
  message         String
  status          ContactStatus @default(new)
  privacyAccepted Boolean       @default(false) @map("privacy_accepted")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  client          Client?       @relation(fields: [clientId], references: [id])
  service         Service?      @relation(fields: [serviceId], references: [id])

  @@index([status, createdAt])
  @@index([email])
  @@index([deletedAt])
  @@map("contact_messages")
}

model Testimonial {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  text        String
  rating      Int       @default(5)
  avatarUrl   String?   @map("avatar_url")
  visible     Boolean   @default(true)
  displayOrder Int      @default(0) @map("display_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([visible, displayOrder])
  @@index([deletedAt])
  @@map("testimonials")
}

model BlogPost {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId   String?     @map("service_id") @db.Uuid
  title       String
  slug        String      @unique
  excerpt     String
  content     String
  category    ServiceType?
  coverImage  String?     @map("cover_image")
  coverImagePublicId String? @map("cover_image_public_id")
  published   Boolean     @default(true)
  readingTime Int?        @map("reading_time")
  publishedAt DateTime?   @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz(6)
  service     Service?    @relation(fields: [serviceId], references: [id])

  @@index([published, publishedAt])
  @@index([category])
  @@index([deletedAt])
  @@map("blog_posts")
}
